# =============================================================
# 统一换行符策略（保证跨机器 clone 后行为一致）
# =============================================================

# 默认：文本文件自动识别，仓库内统一存 LF
* text=auto

# Shell 脚本必须在任何平台都保持 LF，避免上传 Linux 后执行失败
*.sh text eol=lf

# Windows 批处理脚本必须使用 CRLF，否则 cmd 解析可能出现异常
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件：禁止任何换行符转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.zip  binary
*.mp4  binary
*.xlsx binary

# 锁文件保持原样（由 npm 生成，无需人工干预）
package-lock.json -text
