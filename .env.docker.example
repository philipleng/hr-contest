# HR 人力池系统 · Docker Compose 环境变量模板
# 复制为 .env 后填写真实值：cp .env.docker.example .env
# .env 已被 .gitignore 忽略，禁止提交真实密码。

# Docker Web 的宿主机绑定端口
# 80 未被占用时填 80；已有宿主机 Nginx 时填 127.0.0.1:8080 并配置宿主机反代
HTTP_PORT=80

# 本地构建使用的镜像名；GitHub Actions 部署时会自动覆盖为 GHCR 镜像
IMAGE_BACKEND=hr-contest-backend:local
IMAGE_WEB=hr-contest-web:local
IMAGE_TAG=local

# MySQL 5.7.32（宿主机本地数据库）
# Linux 下容器通过 host.docker.internal 访问宿主机，需 MySQL 监听 0.0.0.0，
# 且 hr_system 用户允许从 Docker 网段连接（见 README 的数据库授权说明）。
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=hr_system
DB_USER=hr_system
DB_PASSWORD=REPLACE_WITH_REAL_PASSWORD

# JWT 生产密钥：openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_RANDOM_LONG_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=72

# 阿里云 OSS（留空则使用容器内本地磁盘上传，数据保存在 uploads 卷）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ROLE_ARN=
OSS_BUCKET=
OSS_REGION=ap-southeast-6
OSS_ENDPOINT=

# 管理后台展示 OSS 媒体时使用的域名（仅构建 Web 镜像时需要）
# 例：your-bucket.oss-ap-southeast-6.aliyuncs.com
VITE_OSS_DOMAIN=
