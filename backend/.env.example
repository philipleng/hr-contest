# HR 人力池系统 · 后端环境变量模板
# 复制本文件为 .env，并填入真实值后使用

# 数据库连接（MySQL 5.7.32+ / 8.x）
# 二选一：直接填完整 DATABASE_URL，或留空后填写下面的 DB_* 分段配置。
# Docker Compose 使用 DB_* 分段配置；URL 中的密码特殊字符需自行 URL 编码。
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hr_system
DB_USER=hr_system
DB_PASSWORD=YOUR_DB_PASSWORD

# 启动时自动执行 Alembic 迁移；本地默认关闭，生产部署由 workflow 设为 true
AUTO_MIGRATE=false

# JWT 配置
JWT_SECRET=your-jwt-secret-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=72

# 阿里云 OSS（本地开发可留空，将使用本地上传兜底）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ROLE_ARN=
OSS_BUCKET=
OSS_REGION=ap-southeast-6
OSS_ENDPOINT=
